<?xml version="1.0"?>
<ruleset name="CE Theme">
	<description>Coding standard for CE Theme (since 2.6.32).</description>

	<file>.</file>
	<exclude-pattern>inc/articles/backup/*</exclude-pattern>
	<exclude-pattern>build-articles.php</exclude-pattern>
	<exclude-pattern>vendor/*</exclude-pattern>
	<arg name="extensions" value="php"/>

	<!-- PHP 8.0 through 8.4 (production runs 8.4) and WordPress 6.7+. -->
	<config name="testVersion" value="8.0-8.4"/>
	<config name="minimum_wp_version" value="6.7"/>
	<rule ref="PHPCompatibilityWP"/>

	<!-- Security, database and deprecation rules are enforced in full. -->
	<rule ref="WordPress.Security"/>
	<rule ref="WordPress.DB.PreparedSQL"/>
	<rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
	<rule ref="WordPress.WP.DeprecatedFunctions"/>
	<rule ref="WordPress.WP.DeprecatedParameters"/>
	<rule ref="WordPress.WP.EnqueuedResources"/>
	<rule ref="WordPress.PHP.StrictInArray"/>
</ruleset>
