# Compelling Evidence theme folder. Written by the Compelling Evidence theme.
#
# Apache reads this file on every request into the theme folder, before
# WordPress starts, so the development files an FTP upload brings along are
# refused from the moment they arrive. inc/ce-housekeeping.php deletes them
# on production, and the "Compelling Evidence: block direct file access"
# section in the site's own .htaccess refuses them as well (doc/ssot.md,
# section 30). The tests, bin and tools folders also carry an .htaccess of
# their own that refuses everything in them, for a server without mod_rewrite.
# Nothing here touches the styles, scripts, fonts, images or journey files
# the pages load.

<IfModule mod_rewrite.c>
RewriteEngine On
# Keep the site's own rules (WordPress's 404 for a missing file) for
# requests into this folder.
RewriteOptions Inherit
# The tests, build scripts and tools at the theme root. The pattern is the
# path below this folder, whatever the theme folder's address.
RewriteRule ^(tests|bin|tools)(/|$) - [F]
</IfModule>

# Without mod_rewrite, Apache 2.4 tests the file's own path instead.
<IfModule !mod_rewrite.c>
<IfModule mod_authz_core.c>
<If "%{REQUEST_FILENAME} =~ m#/themes/[^/]+/(tests|bin|tools)(/|$)#">
Require all denied
</If>
</IfModule>
</IfModule>

<IfModule mod_alias.c>
# Every file and folder whose name begins with a dot, wherever it sits in
# the theme: .git, .github, .gitignore, .claude, .vscode, .env, this file and
# the like. .well-known stays open.
RedirectMatch 403 /\.(?!well-known(/|$))[^/]+(/|$)
# No PHP file in the theme serves a page of its own.
RedirectMatch 403 \.php(/|$)
</IfModule>

# Dot files, also without mod_alias.
<FilesMatch "^\.">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>
