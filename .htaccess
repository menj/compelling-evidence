# Compelling Evidence theme folder. Written by the Compelling Evidence theme.
#
# Apache reads this file on every request into the theme folder, before
# WordPress starts, so the development files an FTP upload brings along are
# refused from the moment they arrive. inc/ce-housekeeping.php deletes them
# on production, and the "Compelling Evidence: block direct file access"
# section in the site's own .htaccess refuses them as well (doc/ssot.md,
# section 30). The tests, bin, tools and doc folders also carry an .htaccess
# of their own that refuses everything in them, for a server without
# mod_rewrite. Nothing here touches the styles, scripts, fonts, images or
# journey files the pages load.

<IfModule mod_rewrite.c>
RewriteEngine On
# Keep the site's own rules (WordPress's 404 for a missing file) for
# requests into this folder.
RewriteOptions Inherit
# Dot entries too, for a server without mod_alias (FilesMatch above
# matches a file's own name, not a dot folder such as .git/ above it).
RewriteRule (^|/)\.(?!well-known(/|$)) - [F]
# Theme PHP too, for a server without mod_alias.
RewriteRule \.php(/|$) - [F]
# The tests, build scripts, tools and documentation at the theme root. The
# pattern is the path below this folder, whatever the theme folder's address.
RewriteRule ^(tests|bin|tools|doc)(/|$) - [F]
</IfModule>

# Without mod_rewrite, Apache 2.4 tests the file's own path instead.
<IfModule !mod_rewrite.c>
<IfModule mod_authz_core.c>
<If "%{REQUEST_FILENAME} =~ m#/themes/[^/]+/(tests|bin|tools|doc)(/|$)#">
Require all denied
</If>
</IfModule>
</IfModule>

<IfModule mod_alias.c>
# Every file and folder whose name begins with a dot, wherever it sits in
# the theme: .git, .github, .gitignore, .claude, .vscode, .env, this file and
# the like. .well-known stays open.
RedirectMatch 403 /[.](?!well-known(/|$))[^/]+(/|$)
# No PHP file in the theme serves a page of its own.
RedirectMatch 403 \.php(/|$)
</IfModule>

# Theme PHP files by their own name, with neither mod_alias nor mod_rewrite.
<FilesMatch "\.php$">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>

# Markdown notes (the docs, readmes and changelogs) by their own name,
# wherever they sit and with no module beyond the core. No page links one.
<FilesMatch "(?i)\.md$">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>

# Dot files, also without mod_alias.
<FilesMatch "^\.">
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
Order allow,deny
Deny from all
</IfModule>
</FilesMatch>

# Dot folders such as .git/ on Apache 2.4 even without mod_alias and
# mod_rewrite (FilesMatch matches a file's own name, not the folder above it).
<IfModule mod_authz_core.c>
<If "%{REQUEST_URI} =~ m#/\.(?!well-known(/|$))#">
Require all denied
</If>
</IfModule>
